{
  "expo": {
    "name": "County Green",
    "slug": "county-green",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/cg/app-icon.png",
    "scheme": "county-green",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.countygreens.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/cg/adaptive-icon.png",
        "backgroundColor": "#0A3A2F"
      },
      "package": "com.countygreens.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cg/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#0A3A2F"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50e495dd-f9b5-46a3-b337-a7c963324e08"
      }
    },
    "owner": "kuberjha1998"
  }
}
