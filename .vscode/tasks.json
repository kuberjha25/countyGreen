		},
		{
			"label": "Build APK using Windows safe path",
			"type": "shell",
			"command": "$root='D:\\county-green-main(1)\\county-green-main\\frontend'; & subst X: $root; Set-Location X:\\android; .\\gradlew.bat assembleRelease",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build County Green APK without path parsing issues",
			"type": "shell",
			"command": "node",
			"args": [
				"-e",
				"const { spawnSync } = require('node:child_process'); const root = process.cwd(); const alias = spawnSync('subst.exe', ['X:', root], { stdio: 'inherit' }); if (alias.status !== 0) process.exit(alias.status || 1); const build = spawnSync('cmd.exe', ['/d', '/c', 'X:\\\\android\\\\gradlew.bat', 'assembleRelease'], { cwd: 'X:\\\\android', stdio: 'inherit' }); spawnSync('subst.exe', ['X:', '/d'], { stdio: 'inherit' }); process.exit(build.status || 0);"
			],
			"isBackground": false,
			"problemMatcher": []
		},
